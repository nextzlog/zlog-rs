# 日本語. Lines are `key = text`; {0}, {1} are filled in by the program.
title = Discord
tip = 記録した交信を、オプションで設定した Discord や Slack のチャンネルへ投稿します
menu.post = QSO を自動投稿
menu.post.tip = 記録した交信を {0} へ投稿します
enabled = 交信ごとに {0} へ投稿する
url = Webhook URL
url.tip.discord = チャンネルの Webhook URL (チャンネルの設定 > 連携サービス > ウェブフック)。知っていれば誰でも投稿できるので、人に教えないでください
url.tip.slack = チャンネルの Incoming Webhook の URL (Slack アプリの Incoming Webhooks > 新しい Webhook を追加)。知っていれば誰でも投稿できるので、人に教えないでください
shared = 共通の設定
edits = 訂正と削除も投稿する
preview = 投稿の例
note = 投稿は裏で行い、投稿先ごとに間隔を空けます (Discord は2秒に1通、Slack は1秒に1通まで)。一度に多く記録したときは数件をまとめて1通にします。Z-Link で他の局から届いた交信、取り込んだ交信、ファイルから読んだ交信は投稿しません。
test = 送信テスト
test.tip = 上の URL にテストメッセージを投稿します
test.message = zLog RS: テストメッセージ
test.sending = 送信中...
test.sent = テストメッセージを投稿しました。
test.wait = {0} から{1}秒待つよう求められました。少し後で試してください。
test.failed = 投稿できませんでした: {0}
post.corrected = 訂正: {0} → {1}
post.deleted = 削除: {0}
status.waiting = {0}: 送信待ち{1}件
status.off = {0}: 送信オフ ({1}件)
status.failed = {0}: 未送信 ({1}件)
status.failed.tip = {0}: 最後のエラー: {1}
status.dropped = {0}: {1}件を破棄 (キューが満杯)
